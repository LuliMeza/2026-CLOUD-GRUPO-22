# Variables de entorno de producción (Render y Vercel)
# Este archivo sirve como plantilla de referencia. No incluir credenciales reales acá.

# -----------------------------------------------------------------------------
# Base de datos Neon PostgreSQL (Configurar en el Dashboard de Render)
# -----------------------------------------------------------------------------
# Connection string pooled para la aplicación
DATABASE_URL="postgresql://<neondb_owner>:<password>@<ep-pooler-domain>.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Connection string directa / unpooled para migraciones Prisma CLI
DATABASE_URL_UNPOOLED="postgresql://<neondb_owner>:<password>@<ep-domain>.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Neon Auth (Opcional - solo si la aplicación utiliza Managed Better Auth)
# -----------------------------------------------------------------------------
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://<ep-domain>.neonauth.c-14.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<ep-domain>.neonauth.c-14.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# -----------------------------------------------------------------------------
# Frontend (Configurar en el Dashboard de Vercel)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://two026-cloud-grupo-22-back.onrender.com
