{
  "name": "2026-cloud-grupo-22",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "concurrently \"npm run start --workspace=@cloud-grupo-22/api\" \"npm run start --workspace=@cloud-grupo-22/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace=@cloud-grupo-22/api",
    "dev:web": "npm run dev --workspace=@cloud-grupo-22/web",
    "db:generate": "npm run db:generate --workspace=@cloud-grupo-22/api",
    "db:migrate": "npm run db:migrate --workspace=@cloud-grupo-22/api",
    "db:studio": "npm run db:studio --workspace=@cloud-grupo-22/api",
    "build:shared": "npm run build --workspace=@cloud-grupo-22/shared",
    "dev:shared": "npm run dev --workspace=@cloud-grupo-22/shared"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}