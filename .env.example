# Copiar como .env o .env.local para desarrollo local. No guardar secretos reales en Git.

# -----------------------------------------------------------------------------
# Opción A: Base de datos local con Docker Compose
# -----------------------------------------------------------------------------
POSTGRES_DB=utn_grupo_22
POSTGRES_USER=utn
POSTGRES_PASSWORD=utn_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://utn:utn_local_password@localhost:5432/utn_grupo_22?schema=public

# -----------------------------------------------------------------------------
# Opción B: Base de datos en la nube con Neon (descomentar si no usas Docker)
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-domain>/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Puertos y Endpoints
# -----------------------------------------------------------------------------
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mocks de la API en el navegador (msw), solo para desarrollo sin backend.
# Ver apps/web/src/mocks/handlers.ts para qué email dispara cada estado.
# NEXT_PUBLIC_API_MOCKING=enabled
